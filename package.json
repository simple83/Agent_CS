{
  "name": "agent-cs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode real",
    "dev:real": "vite --mode real",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build --mode production",
    "build:mock": "tsc -b && vite build --mode mock --outDir dist-mock",
    "test:api": "node --test tests/api.test.mjs",
    "test:hooks": "node --test tests/post-hooks.test.mjs",
    "test:editor": "node --test tests/post-editor.test.mjs tests/visual-editor.test.mjs",
    "test:likes": "node --test tests/post-likes.test.mjs",
    "test:auth": "node --test tests/auth-navigation.test.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:mock": "vite preview --outDir dist-mock"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "prosemirror-markdown": "^1.13.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "rehype-highlight": "^7.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
